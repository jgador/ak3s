{
  "description": "Format changed Go files and review language before Codex finishes a turn.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/format-go.sh\"",
            "timeout": 30,
            "statusMessage": "Formatting Go files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/review-language.py\"",
            "timeout": 10,
            "statusMessage": "Reviewing language and terminology"
          }
        ]
      }
    ]
  }
}
